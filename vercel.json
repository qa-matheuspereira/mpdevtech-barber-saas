{
  "framework": null,
  "buildCommand": "pnpm vite build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.cts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.cts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
